###############################################################################
# terraform/onprem/terraform.tfvars.example
#
# 사용법:
#   cp terraform.tfvars.example terraform.tfvars
#   vim terraform.tfvars     # 본인 환경 값으로 수정
#
# 이 파일은 git에 커밋해도 OK (실제 값 없음).
# terraform.tfvars (실제 값)는 .gitignore에 포함되어 커밋 안 됨.
###############################################################################

# Proxmox API 엔드포인트 (kosa1 노드)
proxmox_endpoint = "https://192.168.21.2:8006/"

# Proxmox API 토큰
# 발급: Datacenter > Permissions > API Tokens > Add
# 형식: <user>@<realm>!<token_id>=<uuid_secret>
proxmox_api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"

# Proxmox host 접근용 SSH 키 (bpg provider 내부 사용)
proxmox_ssh_private_key_path = "~/.ssh/id_ed25519"

# 생성된 VM에 주입할 SSH 공개키 (cloud-init이 ubuntu 사용자에 등록)
# 명령: cat ~/.ssh/kosa_iac.pub
ssh_public_key = "ssh-ed25519 AAAAC3Nz... kosa-iac"

###############################################################################
# 아래 항목들은 기본값이 정해져 있어 환경 맞을 때만 override
###############################################################################

# 템플릿 VMID/노드 (Lab 2에서 만든 cloud-init 템플릿)
# template_vm_id   = 9000
# template_vm_node = "kosa1"

# VLAN/네트워크 — 기본값 사용 시 생략 가능
# internal_vlan_tag = 30
# mgmt_vlan_tag     = 40
# internal_gateway  = "172.16.23.1"
# mgmt_gateway      = "172.16.24.1"
