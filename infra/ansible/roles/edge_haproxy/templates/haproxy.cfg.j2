global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-ciphers ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:!RC4
    ssl-default-bind-options ssl-min-ver TLSv1.2
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option redispatch
    retries 3
    timeout connect 5s
    timeout client 60s
    timeout server 60s

frontend https-in
    bind *:443 ssl crt {{ haproxy_tls_crt }} alpn h2,http/1.1
    mode http
    http-request return status 200 content-type "text/plain" string "OK\n" if { path /healthz }
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Real-IP %[src]
    acl allowed_host hdr(host) -i {{ haproxy_frontend_domains | join(' ') }}
    use_backend k8s-ingress if allowed_host
    default_backend default-404

frontend http-redirect
    bind *:80
    mode http
    redirect scheme https code 301

backend k8s-ingress
    mode http
    server ingress {{ haproxy_backend_ingress_host }}:{{ haproxy_backend_ingress_port }} check ssl verify none fall 5 rise 2 inter 3000

backend default-404
    mode http
    http-request deny deny_status 404

{% if haproxy_stats_enabled | bool %}
listen stats
    bind *:9000
    mode http
    stats enable
    stats hide-version
    stats uri /stats
    stats refresh 10s
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}
