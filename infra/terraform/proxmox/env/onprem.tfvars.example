proxmox_endpoint        = "https://PROXMOX_API_HOST:8006/"
proxmox_insecure        = true
template_node_name      = "PROXMOX_TEMPLATE_NODE"
template_vm_id          = 9000
cloud_init_datastore_id = "local-lvm"

ssh_public_keys = [
  "ssh-ed25519 AAAA... operator-key",
]

vm_definitions = {
  "k8s-cp1" = {
    vm_id     = 210
    name      = "k8s-cp1"
    node_name = "PROXMOX_NODE_NAME"
    role      = "control-plane"
    tags      = ["control-plane", "k8s", "managed-by-terraform"]
    cpu_cores = 2
    memory_mb = 8192

    primary_disk = {
      datastore_id = "ceph-rbd-team2"
      size_gb      = 40
    }

    extra_disks = [
      {
        interface    = "scsi1"
        datastore_id = "local-lvm"
        size_gb      = 10
      },
    ]

    networks = [
      {
        bridge       = "vmbr0"
        vlan_id      = 30
        mac_address  = "02:00:00:00:00:10"
        ipv4_address = "10.0.30.10/24"
        gateway      = "10.0.30.1"
      },
      {
        bridge       = "vmbr1"
        mtu          = 9000
        mac_address  = "02:00:00:00:10:10"
        ipv4_address = "10.0.90.110/24"
      },
    ]
  }

  "k8s-cp2" = {
    vm_id     = 211
    name      = "k8s-cp2"
    node_name = "PROXMOX_NODE_NAME"
