        mac_address  = "02:00:00:00:00:11"
        ipv4_address = "10.0.30.11/24"
        gateway      = "10.0.30.1"
      },
      {
        bridge       = "vmbr1"
        mtu          = 9000
        mac_address  = "02:00:00:00:10:11"
        ipv4_address = "10.0.90.111/24"
      },
    ]
  }

  "k8s-cp3" = {
